doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    a(href="/") Volver al Inicio
    hr
    nav
      a(href="/vista/lotes") Lotes
      |  |
      a(href="/vista/tecnicos") Técnicos
      |  |
      a(href="/vista/tipos-cultivo") Tipos de cultivo
      |  |
      a(href="/vista/usuarios") Usuarios
    if productores.length > 0
      table(border="1", cellpadding="5")
        thead
          tr
            th Productor
            th Establecimiento
            th Teléfono
            th Email
        tbody
          each productor in productores
            tr
              td #{productor.nombre} #{productor.apellido}
              td= productor.establecimiento || 'Sin asignar'
              td= productor.telefono || 'Sin teléfono'
              td= productor.email || 'Sin email'
    else
      p No hay productores registrados.
