doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    a(href="/") Volver al Inicio
    hr
    nav
      a(href="/vista/lotes") Lotes
      |  |
      a(href="/vista/productores") Productores
      |  |
      a(href="/vista/tecnicos") Técnicos
      |  |
      a(href="/vista/usuarios") Usuarios
    if tiposCultivo.length > 0
      table(border="1", cellpadding="5")
        thead
          tr
            th #
            th Tipo de cultivo
        tbody
          each tipo, index in tiposCultivo
            tr
              td= index + 1
              td= tipo.nombre
    else
      p No hay tipos de cultivo registrados.
