doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    form(action="/vista/lotes", method="get")
      button(type="submit") Volver a Lotes
    h2 Historial de Observaciones
    if observaciones.length > 0
      table
        thead
          tr
            th Fecha
            th Técnico
            th Cultivo
            th Estado
            th Observaciones
            th Alerta
        tbody
          each obs in observaciones
            tr
              td= obs.fecha ? new Date(obs.fecha).toLocaleDateString('es-AR') : '-'
              td= obs.id_tecnico ? (obs.id_tecnico.nombre + ' ' + obs.id_tecnico.apellido) : 'N/A'
              td= obs.tipo_cultivo
              td= obs.estado_cultivo
              td= obs.observaciones
              td= obs.nivel_alerta
    else
      p No hay observaciones registradas para este lote.
