doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    a(href="/") Volver al Inicio
    hr
    nav
      a(href="/vista/productores") Productores
      |  |
      a(href="/vista/tecnicos") Técnicos
      |  |
      a(href="/vista/tipos-cultivo") Tipos de cultivo
      |  |
      a(href="/vista/usuarios") Usuarios
    if lotes.length > 0
      table(border="1", cellpadding="5")
        thead
          tr
            th Lote
            th Productor
            th Acciones
        tbody
          each lote in lotes
            tr
              td= lote.nombre_numero
              td= lote.id_productor ? lote.id_productor.nombre + ' ' + lote.id_productor.apellido : 'Sin asignar'
              td
                a(href=`/vista/lotes/${lote._id}`) Ver historial
    else
      p No hay lotes registrados.
