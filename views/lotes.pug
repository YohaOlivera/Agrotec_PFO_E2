doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    a(href="/") Volver al Inicio
    hr
    if lotes.length > 0
      ul
        each lote in lotes
          li
            span Lote: #{lote.nombre_numero} (Productor: #{lote.id_productor ? lote.id_productor.nombre + ' ' + lote.id_productor.apellido : 'Sin asignar'}) 
            a(href=`/vista/lotes/${lote._id}`) Ver Historial
    else
      p No hay lotes registrados.

