doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    form(action="/", method="get")
      button(type="submit") Inicio
    form(action="/vista/productores", method="get")
      button(type="submit") Productores
    form(action="/vista/tecnicos", method="get")
      button(type="submit") Técnicos
    form(action="/vista/tipos-cultivo", method="get")
      button(type="submit") Cultivos
    form(action="/vista/usuarios", method="get")
      button(type="submit") Usuarios
    if lotes.length > 0
      table
        thead
          tr
            th Lote
            th Productor
            th Acciones
        tbody
          each lote in lotes
            tr
              td= lote.nombre_numero
              td= lote.id_productor ? lote.id_productor.nombre + ' ' + lote.id_productor.apellido : 'Sin asignar'
              td
                form(action=`/vista/lotes/${lote._id}`, method="get")
                  button(type="submit") Ver historial
    else
      p No hay lotes registrados.
