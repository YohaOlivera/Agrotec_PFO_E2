doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    form(action="/", method="get")
      button(type="submit") Inicio
    form(action="/vista/productores", method="get")
      button(type="submit") Productores
    form(action="/vista/tipos-cultivo", method="get")
      button(type="submit") Cultivos
    form(action="/vista/usuarios", method="get")
      button(type="submit") Usuarios
    form(action="/vista/lotes", method="get")
      button(type="submit") Lotes
    if tecnicos.length > 0
      table
        thead
          tr
            th Técnico
            th Especialidad
            th Teléfono
            th Email
        tbody
          each tecnico in tecnicos
            tr
              td #{tecnico.nombre} #{tecnico.apellido}
              td= tecnico.especialidad || 'Sin especificar'
              td= tecnico.telefono || 'Sin teléfono'
              td= tecnico.email || 'Sin email'
    else
      p No hay técnicos registrados.
