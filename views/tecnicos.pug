doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title
  body
    h1= title
    a(href="/") Volver al Inicio
    hr
    nav
      a(href="/vista/lotes") Lotes
      |  |
      a(href="/vista/productores") Productores
      |  |
      a(href="/vista/tipos-cultivo") Tipos de cultivo
      |  |
      a(href="/vista/usuarios") Usuarios
    if tecnicos.length > 0
      table(border="1", cellpadding="5")
        thead
          tr
            th Técnico
            th Especialidad
            th Teléfono
            th Email
        tbody
          each tecnico in tecnicos
            tr
              td #{tecnico.nombre} #{tecnico.apellido}
              td= tecnico.especialidad || 'Sin especificar'
              td= tecnico.telefono || 'Sin teléfono'
              td= tecnico.email || 'Sin email'
    else
      p No hay técnicos registrados.
